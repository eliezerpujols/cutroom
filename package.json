{
  "name": "cutroom-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,editor \"npm:server\" \"npm:client\"",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts --production",
    "mcp": "node --env-file-if-exists=.env --import tsx server/mcp.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remotion/bundler": "4.0.539",
    "@remotion/player": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "lucide-react": "^0.577.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.539",
    "tailwind-merge": "^3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "zod": "$zod"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
