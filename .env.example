# Optional absolute path to FFmpeg. Leave empty to use ffmpeg from PATH.
# This file is loaded by npm start, npm run server, and npm run mcp.
FFMPEG_PATH=

# Optional default library location. Empty uses ~/Documents/Cut Room.
CUTROOM_PROJECTS_DIR=

# Local editing needs no provider keys. Translation/dubbing uses ElevenLabs;
# optional lip sync uses Sync. Store real values only in the ignored local .env.
ELEVENLABS_API_KEY=
SYNC_API_KEY=

# Automatic per-video spending limits; never increase without user approval.
# ElevenLabs credits and Sync USD are separate billing units.
CUTROOM_MAX_ELEVENLABS_CREDITS=10000
CUTROOM_MAX_SYNC_USD=3

# Conservative legacy-credit estimate for Dubbing v2, plus a 500-credit reserve.
# Confirm the account's current billing basis before changing this assumption.
CUTROOM_ELEVENLABS_CREDITS_PER_MINUTE=13500
