# Optional absolute path to FFmpeg. Leave empty to use ffmpeg from PATH.
# This file is loaded by npm start, npm run server, and npm run mcp.
FFMPEG_PATH=

# Optional default library location. Empty uses ~/Documents/Cut Room.
CUTROOM_PROJECTS_DIR=

# Cutroom runs locally and requires no ElevenLabs, Sync, or OpenAI API keys.
# Keep real credentials in an ignored .env file if adding integrations later.
